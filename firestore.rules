rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must be signed in with a @jakala.com account
    function isJakala() {
      return request.auth != null &&
             request.auth.token.email.matches('.*@jakala\\.com$');
    }

    // Caller is an admin (role read from their own users/{uid} doc)
    function isAdmin() {
      return isJakala() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Mirrors BOOTSTRAP_ADMINS in the app
    function isBootstrap() {
      return request.auth.token.email == 'federico.gennari@jakala.com';
    }

    // config/** (invite allowlist at config/access) — all jakala users read; only admins write
    match /config/{doc} {
      allow read:  if isJakala();
      allow write: if isAdmin();
    }

    // users — self read; self create only as member (admins are promoted afterwards);
    // self update never touches role or active; admins read/write all
    match /users/{uid} {
      allow read:   if isJakala() && (request.auth.uid == uid || isAdmin());
      allow create: if isJakala() && request.auth.uid == uid
                    && (request.resource.data.role == 'member' || isBootstrap());
      allow update: if isJakala() && (
                      isAdmin()
                      || (request.auth.uid == uid
                          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active']))
                    );
    }
  }
}
